loggf	0	expand 0.8

		data results.svbplt
		define star read 1 2
		define phmin1 read 3 2
		define phmax1 read 4 2
		define phmin2 read 5 2
		define phmax2 read 6 2
		define meanMbol read 13 2
		define mass read 17 2
		define meanloggf read 30 2

		data thphot.svbplt
		#data ALL.svbplt
		#data tmpp

		read ph 1
		read y 2
		read sy 3
		read teff 4
		read VK 5
		read logg 6
		read loggf 7
		read L 8
		read Mbol 9


		window 2 -3 1 1

		limits ph Mbol
		limits $fx1 $fx2 $fy2 $fy1
		lweight 2
		box
		xlabel Phase
		ylabel M\\dbol\\u
		lweight 1

		ptype 4 3
		points ph Mbol if(ph >= $phmin1 && ph <= $phmax1)
		points ph Mbol if(ph >= $phmin2 && ph <= $phmax2)
		ptype 4 1
		points ph Mbol if(ph >= $phmax1 && ph <= $phmin2)
		points ph Mbol if(ph < $phmin1 || ph > $phmax2)

		limits 0 1 0 1
		relocate 0.08 0.20
		lweight 2
		putlabel 6 $star
		relocate 0.08 0.10
		putlabel 6 Mass: $mass M\\dsolar\\u
		lweight 1



		window 2 -3 1 2

		limits ph logg
		limits $fx1 $fx2 $fy2 $fy1
		lweight 2
		box 0 2
		ylabel log(g)
		lweight 1

		ptype 4 3
		points ph logg if(ph >= $phmin1 && ph <= $phmax1)
		points ph logg if(ph >= $phmin2 && ph <= $phmax2)
		ptype 4 1
		points ph logg if(ph >= $phmax1 && ph <= $phmin2)
		points ph logg if(ph < $phmin1 || ph > $phmax2)

		window 2 -3 1 3

		limits ph loggf
		limits $fx1 $fx2 $fy2 $fy1
		lweight 2
		box 0 2
		ylabel log(g\dF)
		lweight 1

		ptype 4 3
		points ph loggf if(ph >= $phmin1 && ph <= $phmax1)
		points ph loggf if(ph >= $phmin2 && ph <= $phmax2)
		ptype 4 1
		points ph loggf if(ph >= $phmax1 && ph <= $phmin2)
		points ph loggf if(ph < $phmin1 || ph > $phmax2)

		window 2 2 2 2

		limits loggf Mbol
		limits $fx2 $fx1 $fy2 $fy1
		lweight 2
		box
		xlabel log(g\dF)
		ylabel M\\dbol\\u
		lweight 1

		ptype 4 3
		points loggf Mbol if(ph >= $phmin1 && ph <= $phmax1)
		points loggf Mbol if(ph >= $phmin2 && ph <= $phmax2)
		ptype 4 1
		points loggf Mbol if(ph >= $phmax1 && ph <= $phmin2)
		points loggf Mbol if(ph < $phmin1 || ph > $phmax2)

		ptype 4 0
		angle 45
		expand 1.2
		relocate $meanloggf $meanMbol
		dot
		angle 0
		expand 0.8


		window 2 2 2 1
		#limits 3.7 1.4 0 -8
		limits 3.7 1.2 0 -8.5
		lweight 2
		box
		xlabel log(g\dF)
		ylabel M\\dbol\\u
		lweight 1

		ptype 4 3
		points loggf Mbol if(ph >= $phmin1 && ph <= $phmax1)
		points loggf Mbol if(ph >= $phmin2 && ph <= $phmax2)
		ptype 4 1
		points loggf Mbol if(ph >= $phmax1 && ph <= $phmin2)
		points loggf Mbol if(ph < $phmin1 || ph > $phmax2)

		ptype 4 0
		angle 45
		expand 1.2
		relocate $meanloggf $meanMbol
		dot
		angle 0
		expand 0.8

		# Eq3 Groenewegen 2020
		relocate 1.5 -8.0
		draw 3.5 -1.27

