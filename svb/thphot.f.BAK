      subroutine thphot(idx,logg,thetap,sigthp)

c-- Returns the photometric angular diameter (in milli arcsec)
c   for a given phase on basis on the photometric data and the
c   temperature and Bolometric corrections from model atmospheres.
c
c-----------------------------------------------------------------------
c   By: Jesper Storm                    | e-mail: jstorm@eso.org
c   At: European Southern Observatory   |
c Date: April 11, 1995                  | Version: 0.1
c-----------------------------------------------------------------------

      include 'svb.h'

      real Sv,teff,bc,v,thetap,theta,col,logg,sigthp
      real thetapx,tx
      integer iflag,idx

      if(ctrel .eq. 'FG_linearVVK') then
         thetap = 10**(0.5474 - 0.2*mag(idx) + 0.262*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.262*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'Kerv_linearVVK') then
         thetap = 10**(0.5354 - 0.2*mag(idx) + 0.2672*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2672*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'Kerv_dwarf_linearVVK') then
         thetap = 10**(0.5178 - 0.2*mag(idx) + 0.2652*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2652*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto98V_linearVVK') then
c-- Relation from class V stars linearized at V-K=1.0
         thetap = 10**(0.5324 - 0.2*mag(idx) + 0.2736*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2736*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto98III_linearVVK') then
c-- Relation from class III stars linearized at V-K=1.0
         thetap = 10**(0.5380 - 0.2*mag(idx) + 0.2710*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2710*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto98III_linearVVKoff') then
c-- Relation from class III stars linearized at V-K=1.0
         col=color(idx)+0.05
         thetap = 10**(0.5380 - 0.2*mag(idx) + 0.2710*col)
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2710*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto98III_parabVVK') then
         thetap = 10**(0.5314 - 0.2*mag(idx) + 0.2842*color(idx)-
     +            0.0066*color(idx)*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2842*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto98III_parabVVKoff') then
         col = color(idx) + 0.05
         thetap = 10**(0.5314 - 0.2*mag(idx) + 0.2842*col -
     +            0.0066*col*col)
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2842*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto98all_parabVVK') then
         thetap = 10**(0.5126 - 0.2*mag(idx) + 0.2986*color(idx)-
     +            0.0092*color(idx)*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2986*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto05_parabVVK') then
         thetap = 10**(0.5130 - 0.2*mag(idx) + 0.2966*color(idx)-
     +            0.0088*color(idx)*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2966*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto05_linearVVK') then
         thetap = 10**(0.5218 - 0.2*mag(idx) + 0.2802*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2802*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto05_linearVVKoff') then
         thetap = 10**(0.5218-0.2*mag(idx)+0.2802*(color(idx)+0.055))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2802*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'diBenedetto05CEP_linearVVK') then
         thetap = 10**(0.5434 - 0.2*mag(idx) + 0.2624*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2624*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'dCep_linearVVK') then
         thetap = 10**(0.5594 - 0.2*mag(idx) + 0.2468*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2468*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'dCep22_linearVVK') then
         thetap = 10**(0.5594 - 0.2*mag(idx) + 0.22*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2468*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'dCep24_linearVVK') then
         thetap = 10**(0.5594 - 0.2*mag(idx) + 0.24*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.24*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'dCep26_linearVVK') then
         thetap = 10**(0.5594 - 0.2*mag(idx) + 0.26*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.26*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'V9_linearVVK') then
         thetap = 10**(0.55 - 0.2*mag(idx) + 0.256*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.26*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'Gro08_linearVVK') then
         thetap = 10**(0.5283 - 0.2*mag(idx) + 0.2724*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2724*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_linearVVK075') then
         thetap = 10**(0.5474 - 0.2*mag(idx) + 0.257*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.262*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'SEDF_VVK') then
         thetap = 10**(0.5135 - 0.2*mag(idx) + 0.2687*color(idx)
     +            - 0.0174*color(idx)*color(idx)
     +            - 0.0028*logg)
         sigthp = sqrt((0.2*smag(idx))**2 + (0.262*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_linearVVK225') then
         thetap = 10**(0.5474 - 0.2*mag(idx) + 0.2658*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.262*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_linearVVKsmc') then
         thetap = 10**(0.5520 - 0.2*mag(idx) + 0.2603*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.2603*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_linearVVKexp') then
         thetap=10**(0.5074 - 0.2*mag(idx) + 0.308*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.308*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_linearVVR') then
         thetap=10**(0.5474 - 0.2*mag(idx) + 0.760*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.760*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_linearVVRexp') then
         thetap=10**(0.5474 - 0.2*mag(idx) + 0.700*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.700*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_linearKJK') then
         thetap = 10**(0.5474 - 0.2*mag(idx) + 0.220*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.220*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'FG_parabVVR') then
         thetap = 10**(0.4419 - 0.2*mag(idx) + 0.9685*color(idx)-
     +            0.10652*color(idx)*color(idx))
         sigthp = sqrt((0.2*smag(idx))**2 + (0.760*scolor(idx))**2)
     +            * thetap * log(10.)
         return
      elseif(ctrel .eq. 'tabular') then
         goto 200
      else
         write(nstdout,'(''ERROR: No valid color-temperature '',
     +   '' relation specified'')')
         return
      endif

c-- For the tabular approach (Fry and Carney tables f.ex.)
c
  200 continue

      phase=phmag(idx)
c-- Get the color and magnitude at the requested phase
c
      call int1d(nmag,phmag,color,phase,col,iflag)
      call int1d(nmag,phmag,mag,phase,v,iflag)

c-- Get the temperature
c
      call gett(ncol,nrow,loggs,ths,colg,logg,col,teff,iflag)
      if(iflag .lt. 0) then
	 write(nstdout,'(''Warning: gett Interpolation failed'')')
	 nwarn=nwarn+1
	 write(nstdout,*) phase,logg,col,v
      endif
      theta=5040./teff

c-- Get the Bolometric Correction
c
      call int2d(ncol,nrow,loggs,ths,bcg,logg,theta,bc,iflag)
      if(iflag .lt. 0) then
	 write(nstdout,'(''Warning: Interpol. failed for Theta and BC'')')
	 nwarn=nwarn+1
      endif

      teff=5040./theta

      if(teff .gt. 0) then
         Sv = Sv0 - 10. * log10(teff) - bc
      else
	 write(nstdout,'(''ERROR: Teff negative in thphot'')')
      endif

      tempo = (Sv - v)/5.
      thetap = 10**((Sv - v)/5.)
      sigthp = 1.0

c      thetapx=10**(0.5474 - 0.2*mag(idx) + 0.760*color(idx))
c      tx=10**(3.947 - 0.379*color(idx)-0.1*bc)
c      write(nstdout,*) phase,color(idx),col,logg,bc
c      write(nstdout,*) teff,tx,thetap,thetapx

  900 continue
      return
      end
